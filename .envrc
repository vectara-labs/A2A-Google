#!/usr/bin/env bash

CONDA_ENV_NAME=A2A-Google
# First ensure direnv is properly initialized
if has direnv; then
  # Try to directly use the conda activate command instead of layout_conda
  if command -v conda >/dev/null 2>&1; then
    # Get the conda base path
    CONDA_BASE=$(conda info --base)
    
    # Source the conda.sh script to get the activate function
    source "$CONDA_BASE/etc/profile.d/conda.sh"
    
    # Activate the automob environment
    conda activate $CONDA_ENV_NAME
    
    # Notify success
    echo "Successfully activated conda environment: $CONDA_ENV_NAME"

    # # Now activate venv
    # if [ -d ".venv" ]; then
    #   source .venv/bin/activate
    # else
    #   echo "No .venv found. Please run: python -m venv .venv"
    #   exit 1
    # fi

  else
    echo "Error: conda is not installed or not in PATH"
    exit 1
  fi
else
  echo "Error: direnv is not installed or not in PATH"
  exit 1
fi